NOTION_PROPERTY_DATE=date
NOTION_PROPERTY_TAGS=tags
NOTION_PROPERTY_TYPE_POST=Post
NOTION_PROPERTY_STATUS_PUBLISH=Published

# The original CONFIG-page values still have higher priority at runtime. These
