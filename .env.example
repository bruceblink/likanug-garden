# Official Notion API. Create an Internal integration, share the database with
# it through Notion's Connections menu, then paste its secret here.
NOTION_PAGE_ID=
NOTION_API_KEY=
# Keep this aligned with the Notion API version used by the Markdown endpoint.
NOTION_API_VERSION=2026-03-11

NEXT_PUBLIC_SITE_URL=https://blog.likanug.top
NEXT_PUBLIC_SITE_NAME=likanug
NEXT_PUBLIC_SITE_DESCRIPTION=Build quietly. Ship relentlessly. // 把好奇心编译成作品。
NEXT_PUBLIC_REVALIDATE_SECONDS=300

# Existing Notion property names. Change only when your original schema differs.
NOTION_PROPERTY_TYPE=type
NOTION_PROPERTY_TITLE=title
NOTION_PROPERTY_STATUS=status
NOTION_PROPERTY_SUMMARY=summary
NOTION_PROPERTY_SLUG=slug
NOTION_PROPERTY_CATEGORY=category
NOTION_PROPERTY_DATE=date
NOTION_PROPERTY_TAGS=tags
NOTION_PROPERTY_TYPE_POST=Post
NOTION_PROPERTY_STATUS_PUBLISH=Published

# The original CONFIG-page values still have higher priority at runtime. These
# environment values remain fallbacks, exactly as in the old project.
